{
  "systemSetup": [
    {
      "name": "Install pip",
      "command": "curl -fsSL https://bootstrap.pypa.io/get-pip.py | python3 - --user --break-system-packages"
    },
    {
      "name": "Install FFmpeg",
      "command": "curl -fsSL https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz -o /tmp/ff.tar.xz && tar -xJf /tmp/ff.tar.xz -C /tmp && cp -f /tmp/ffmpeg-master-latest-linux64-gpl/bin/ffmpeg /tmp/ffmpeg-master-latest-linux64-gpl/bin/ffprobe /usr/local/bin/ && rm -rf /tmp/ff.tar.xz /tmp/ffmpeg-master-latest-linux64-gpl"
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install PyTorch",
      "command": "python3 -m pip install --user --break-system-packages torch --index-url https://download.pytorch.org/whl/cpu"
    },
    {
      "name": "Install Python Dependencies",
      "command": "python3 -m pip install --user --break-system-packages -r requirements.txt || (grep -v 'rvc-python' requirements.txt > /tmp/requirements-filtered.txt && python3 -m pip install --user --break-system-packages -r /tmp/requirements-filtered.txt)"
    }
  ],
  "codeChecks": [
    {
      "name": "Compile Check",
      "command": "python3 -m py_compile engine.py engine/*.py"
    }
  ],
  "buildSteps": [],
  "runStep": [
    {
      "name": "Run Engine",
      "command": "PORT=4000 python3 engine.py",
      "port": "4000"
    }
  ],
  "deploySteps": [],
  "cleanupFiles": [
    "__pycache__",
    "engine/__pycache__",
    "build",
    "output"
  ],
  "packageManager": "pip",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
